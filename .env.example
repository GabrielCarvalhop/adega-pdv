# --- Banco de dados ---
# Postgres da aplicação. Em produção (Railway) use a DATABASE_URL fornecida.
# O runtime deriva o usuário de app (adega_app) do host/porta/database desta URL;
# a URL em si deve apontar para um usuário com poder de criar role/rodar migrations.
DATABASE_URL=postgres://adega:adega@localhost:5433/adega

# Senha do role NÃO-privilegiado usado em runtime (sujeito a RLS). Em produção,
# defina uma senha forte; localmente pode manter o default.
APP_DB_PASSWORD=adega_app_dev

# --- Autenticação ---
# Segredo de assinatura dos JWTs — gere um valor aleatório de 256 bits:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# OBRIGATÓRIO em produção (NODE_ENV=production).
JWT_SECRET=troque-este-valor

# --- Cobrança (gateway próprio do lojista; integração futura) ---
# Placeholders — hoje a ativação/suspensão da assinatura é manual via
# `npm run tenant:status -w server -- <slug> <status>`.
# ASAAS_ENV=sandbox
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_TOKEN=

# --- Aplicação ---
# URL pública (usada em links). Railway define PORT automaticamente.
APP_BASE_URL=http://localhost:4173
PORT=4173
NODE_ENV=development
